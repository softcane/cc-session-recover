{
  "name": "cc-session-recover",
  "version": "0.1.5",
  "description": "Quota-resume workflow for Claude Code: handoff notebook, heartbeat auto-continue, StopFailure hooks, and an unattended watcher that resumes after quota resets.",
  "scripts": {
    "check": "node --check bin/cli.js && bash -n scripts/*.sh .claude/hooks/*.sh .claude/statusline-quota-cache.sh && bash scripts/verify-claude-loop-workflow.sh",
    "test": "bash scripts/test-fake-quota-flow.sh",
    "prepublishOnly": "npm run check && npm test"
  },
  "bin": {
    "cc-session-recover": "bin/cli.js"
  },
  "files": [
    "bin",
    ".claude/auto-continue.md",
    ".claude/standing-instructions.md",
    ".claude/settings.example.json",
    ".claude/statusline-quota-cache.sh",
    ".claude/hooks",
    "scripts",
    "HANDOFF.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "claude",
    "claude-code",
    "quota",
    "rate-limit",
    "resume",
    "hooks",
    "workflow"
  ],
  "author": "Pradeep Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softcane/cc-session-recover.git"
  },
  "bugs": {
    "url": "https://github.com/softcane/cc-session-recover/issues"
  },
  "homepage": "https://github.com/softcane/cc-session-recover#readme"
}
